// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DJ {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  name             String
  firstName        String?
  lastName         String?
  address          String?
  stripeAccountId  String?
  stripeCustomerId String?        @unique
  paypalEmail      String?
  satispayId       String?
  eventCode        String         @unique
  minDonation      Decimal        @default(5.00)
  status           DJStatus       @default(PENDING)
  isAdmin          Boolean        @default(false)
  requests         Request[]
  queue            QueueItem[]
  events           Event[]
  eventSummaries   EventSummary[]
  subscription     Subscription?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("djs")
}

model Request {
  id              String        @id @default(uuid())
  songTitle       String
  artistName      String
  spotifyTrackId  String?
  albumCover      String?
  requesterName   String
  requesterEmail  String?
  donationAmount  Decimal
  paymentMethod   PaymentMethod
  paymentProvider PaymentProvider?
  // Unique because an authorisation pays for exactly one request. Without this
  // the same authorised payment could be spent on several songs.
  paymentIntentId String?          @unique
  paymentStatus   PaymentStatus    @default(PENDING)
  authorizedAt    DateTime?
  capturedAt      DateTime?
  status          RequestStatus    @default(PENDING)
  djId            String
  dj              DJ               @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?           @relation(fields: [eventId], references: [id])
  queueItem       QueueItem?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("requests")
}

model QueueItem {
  id        String      @id @default(uuid())
  requestId String      @unique
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  djId      String
  dj        DJ          @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?      @relation(fields: [eventId], references: [id])
  position  Int
  status    QueueStatus @default(WAITING)
  addedAt   DateTime    @default(now())
  playedAt  DateTime?

  @@map("queue_items")
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  SATISPAY
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CLOSED
  // The request exists but nobody has paid for it yet, so it is invisible to
  // the DJ. It becomes PENDING only once the provider confirms the
  // authorisation. Listed last because Postgres enum values are appended.
  AWAITING_PAYMENT
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  SATISPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  CANCELED
  FAILED
}

enum QueueStatus {
  WAITING
  NOW_PLAYING
  PLAYED
  SKIPPED
}

enum DJStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventSummary {
  id               String   @id @default(uuid())
  djId             String
  dj               DJ       @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventCode        String
  totalRequests    Int
  acceptedRequests Int
  rejectedRequests Int
  expiredRequests  Int
  closedRequests   Int      @default(0)
  playedSongs      Int
  skippedSongs     Int
  totalEarnings    Decimal
  startedAt        DateTime
  endedAt          DateTime @default(now())
  createdAt        DateTime @default(now())

  @@map("event_summaries")
}

model Subscription {
  id                   String             @id @default(uuid())
  djId                 String             @unique
  dj                   DJ                 @relation(fields: [djId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(TRIALING)
  plan                 SubscriptionPlan
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

model Event {
  id          String      @id @default(uuid())
  djId        String
  dj          DJ          @relation(fields: [djId], references: [id], onDelete: Cascade)
  name        String
  eventCode   String      @unique
  description String?
  address     String
  city        String
  latitude    Float
  longitude   Float
  dateTime    DateTime
  endDateTime DateTime?
  status      EventStatus @default(SCHEDULED)
  requests    Request[]
  queueItems  QueueItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([latitude, longitude])
  @@index([status, dateTime])
  @@map("events")
}

enum EventStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}