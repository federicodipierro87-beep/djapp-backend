// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DJ {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  name             String
  firstName        String?
  lastName         String?
  address          String?
  // The DJ's own Stripe Connect account, where the guests' donations land. Set
  // by the server when onboarding starts and never by the DJ: it is the
  // destination of real money, so it cannot be a free-text field.
  stripeAccountId  String?        @unique
  // Stripe's verdict on that account, mirrored here from account.updated so
  // that taking a donation does not need a round trip to Stripe. A DJ can have
  // an account and still not be allowed to charge with it.
  chargesEnabled   Boolean        @default(false)
  payoutsEnabled   Boolean        @default(false)
  stripeCustomerId String?        @unique
  paypalEmail      String?
  // PayPal's own id for the DJ as a merchant, which is what multiparty orders
  // name as the payee. It comes out of partner onboarding; until a DJ has been
  // through that, their PayPal address is all we have to go on.
  paypalMerchantId String?
  // Satispay has no marketplace model, so a donation can only reach the DJ by
  // being made against their own business account. These are that account's API
  // credentials: the key id is public, the private key signs requests for their
  // money and is stored encrypted. Both are written only by the connect flow.
  satispayKeyId      String?
  satispayPrivateKey String?
  eventCode        String         @unique
  minDonation      Decimal        @default(5.00)
  status           DJStatus       @default(PENDING)
  isAdmin          Boolean        @default(false)
  // The SHA-256 of the reset token, never the token itself: the clear text only
  // ever exists inside the link in the email. Unique because a token identifies
  // exactly one DJ, and that is how the reset looks them up.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  // Every JWT issued before this instant is refused. Without it a password
  // reset would leave whoever stole the old password logged in for seven days.
  passwordChangedAt      DateTime?
  requests         Request[]
  queue            QueueItem[]
  events           Event[]
  eventSummaries   EventSummary[]
  subscription     Subscription?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("djs")
}

model Request {
  id              String        @id @default(uuid())
  songTitle       String
  artistName      String
  spotifyTrackId  String?
  albumCover      String?
  requesterName   String
  requesterEmail  String?
  donationAmount  Decimal
  // Null on a free request: there is no money to move, so naming a provider's
  // method would be a lie the release and capture paths would act on.
  paymentMethod   PaymentMethod?
  paymentProvider PaymentProvider?
  // Unique because an authorisation pays for exactly one request. Without this
  // the same authorised payment could be spent on several songs.
  paymentIntentId String?          @unique
  paymentStatus   PaymentStatus    @default(PENDING)
  authorizedAt    DateTime?
  capturedAt      DateTime?
  status          RequestStatus    @default(PENDING)
  djId            String
  dj              DJ               @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?           @relation(fields: [eventId], references: [id])
  queueItem       QueueItem?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // The DJ panel reads its own requests newest first, filtered by status, every
  // few seconds. Postgres does not index foreign keys on its own, so the event
  // lookups were sequential scans over the whole table.
  @@index([djId, status, createdAt])
  @@index([eventId, status])
  @@map("requests")
}

model QueueItem {
  id        String      @id @default(uuid())
  requestId String      @unique
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  djId      String
  dj        DJ          @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?      @relation(fields: [eventId], references: [id])
  position  Int
  status    QueueStatus @default(WAITING)
  addedAt   DateTime    @default(now())
  playedAt  DateTime?

  // The public queue screen polls by event and the DJ panel by dj, both split by
  // status.
  @@index([djId, status])
  @@index([eventId, status])
  @@map("queue_items")
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  SATISPAY
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CLOSED
  // The request exists but nobody has paid for it yet, so it is invisible to
  // the DJ. It becomes PENDING only once the provider confirms the
  // authorisation. Listed last because Postgres enum values are appended.
  AWAITING_PAYMENT
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  SATISPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  CANCELED
  FAILED
  // Nobody is owed anything: the request was free. Distinct from PENDING, which
  // means a payment is expected and has not arrived - the three paths that move
  // real money all select on this column, and neither of them must see this row.
  // Listed last because Postgres enum values are appended.
  NOT_REQUIRED
}

enum QueueStatus {
  WAITING
  NOW_PLAYING
  PLAYED
  SKIPPED
}

enum DJStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventSummary {
  id               String   @id @default(uuid())
  djId             String
  dj               DJ       @relation(fields: [djId], references: [id], onDelete: Cascade)
  eventCode        String
  totalRequests    Int
  acceptedRequests Int
  rejectedRequests Int
  expiredRequests  Int
  closedRequests   Int      @default(0)
  playedSongs      Int
  skippedSongs     Int
  totalEarnings    Decimal
  startedAt        DateTime
  endedAt          DateTime @default(now())
  createdAt        DateTime @default(now())

  // Closing a night looks up the previous one to find where this one started.
  @@index([djId, endedAt])
  @@map("event_summaries")
}

model Subscription {
  id                   String             @id @default(uuid())
  djId                 String             @unique
  dj                   DJ                 @relation(fields: [djId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(TRIALING)
  plan                 SubscriptionPlan
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

model Event {
  id          String      @id @default(uuid())
  djId        String
  dj          DJ          @relation(fields: [djId], references: [id], onDelete: Cascade)
  name        String
  eventCode   String      @unique
  description String?
  address     String
  city        String
  latitude    Float
  longitude   Float
  dateTime    DateTime
  endDateTime DateTime?
  // The minimum tip for this night. Null means the DJ never set one for this
  // event, so their profile default applies - which is what every event created
  // before this column existed has to keep doing. Zero is a decision, not an
  // absence: it opens the night to free requests.
  minDonation Decimal?
  status      EventStatus @default(SCHEDULED)
  requests    Request[]
  queueItems  QueueItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([latitude, longitude])
  @@index([status, dateTime])
  // "My events", and the lookup of the night a DJ is currently running.
  @@index([djId, dateTime])
  @@map("events")
}

enum EventStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}