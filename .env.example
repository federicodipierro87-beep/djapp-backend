DATABASE_URL="postgresql://username:password@localhost:5432/dj_request_db"
JWT_SECRET="your-super-secret-jwt-key"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MONTHLY_PRICE_ID="price_xxx"
STRIPE_ANNUAL_PRICE_ID="price_xxx"
STRIPE_WEBHOOK_SECRET_SUBSCRIPTIONS="whsec_xxx"
# Sends the guests' donations to the DJ's own Stripe account instead of ours.
# Leave off until every DJ has completed onboarding: with it on, a DJ who has
# not cannot take requests at all.
STRIPE_CONNECT_ENABLED="false"
# Signing secret of the Connect endpoint in the Stripe dashboard - a different
# endpoint from the one above, so a different secret.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_xxx"
# Fixed when a connected account is created and not changeable afterwards.
STRIPE_CONNECT_COUNTRY="IT"
# Our cut of each donation, as a percentage. 0 means the DJ keeps all of it.
PLATFORM_FEE_PERCENT="0"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"
# Shown next to the webhook in the PayPal developer dashboard. Without it the
# webhook rejects everything, because it is what PayPal checks the signature
# against.
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
# Which methods guests may choose. PayPal and Satispay are left out until their
# credentials exist and have been tried against a real account.
PAYMENT_METHODS="CARD,APPLE_PAY,GOOGLE_PAY"
# Satispay has no marketplace model, so there are no platform credentials here:
# each DJ connects their own business account from the panel and the keys are
# stored per DJ. This only chooses which Satispay to talk to.
SATISPAY_MODE="sandbox"
# Encrypts the DJ Satispay private keys before they are stored. Generate with
# `openssl rand -base64 32`. Losing it means every DJ has to reconnect; leaking
# it means the database is enough to sign for their money.
CREDENTIALS_ENCRYPTION_KEY=""
FRONTEND_URL="http://localhost:5173"
# Where the providers reach this server. Satispay bakes the callback URL into
# each payment, so it has to be the public address, not localhost.
BACKEND_URL="http://localhost:3001"
PORT=3001
RESEND_API_KEY="re_..."