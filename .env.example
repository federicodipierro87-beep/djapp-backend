DATABASE_URL="postgresql://username:password@localhost:5432/dj_request_db"
JWT_SECRET="your-super-secret-jwt-key"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MONTHLY_PRICE_ID="price_xxx"
STRIPE_ANNUAL_PRICE_ID="price_xxx"
STRIPE_WEBHOOK_SECRET_SUBSCRIPTIONS="whsec_xxx"
# Sends the guests' donations to the DJ's own Stripe account instead of ours.
# Leave off until every DJ has completed onboarding: with it on, a DJ who has
# not cannot take requests at all.
STRIPE_CONNECT_ENABLED="false"
# Signing secret of the Connect endpoint in the Stripe dashboard - a different
# endpoint from the one above, so a different secret.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_xxx"
# Fixed when a connected account is created and not changeable afterwards.
STRIPE_CONNECT_COUNTRY="IT"
# Our cut of each donation, as a percentage. 0 means the DJ keeps all of it.
PLATFORM_FEE_PERCENT="0"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"
SATISPAY_KEY_ID="your-satispay-key-id"
SATISPAY_PRIVATE_KEY="your-satispay-private-key"
FRONTEND_URL="http://localhost:5173"
PORT=3001
RESEND_API_KEY="re_..."